{
  "name": "@neverzero/pi-team",
  "version": "0.2.0",
  "private": true,
  "description": "Shared team workflow for Pi: change specs, Linear coordination, checkpoints and independent review",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "bin": {
    "pi-team": "bin/pi-team.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/team.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "bin",
    "extensions",
    "src",
    "skills",
    "profiles",
    "templates",
    "review",
    "team.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.ts\"",
    "test:e2e": "PI_TEAM_E2E=1 node --test \"tests/e2e/*.test.ts\"",
    "test:sandbox": "PI_TEAM_SANDBOX_E2E=1 node --test tests/sandbox-live.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "check:linear": "node scripts/validate-linear.mjs",
    "smoke:pack": "node scripts/pack-smoke.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@types/node": "^24.0.0",
    "graphql": "^16.14.2",
    "typebox": "1.3.27",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@earendil-works/gondolin": "0.12.0"
  }
}
